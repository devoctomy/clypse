<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- Formatting data (dates, numbers) for every culture, so the app can switch language at runtime. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <!-- Release builds are stamped with when they were built (UTC), shown in Settings > About, so a deployed build can be
       told apart from the last one. Debug builds are not, so they still build incrementally. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>
  <!--
    Release builds are compiled ahead of time to WebAssembly when published (needs the wasm-tools workload:
    dotnet workload install wasm-tools), as the original clypse was. Argon2id, AES-GCM and loading a large vault run
    many times faster than in the interpreted builds of dotnet run and the UI tests. The SDK only AOT compiles on
    publish; a Release build relinks the native runtime instead, so after changing these, build clean, or the old
    output fails at runtime ("function signature mismatch"). AOT makes publishing considerably slower.
    InvariantGlobalization (which the original also set) is not: the app's languages and plural forms need ICU.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blazing.Mvvm" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- The AWS base stack and deploy scripts at the framework's version, run by cloudformation/deploy.ps1. -->
    <PackageReference Include="Devoctomy.Blazwiz.Aws" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clypse.Portal.Application\Clypse.Portal.Application.csproj" />
    <ProjectReference Include="..\Clypse.Portal.Models\Clypse.Portal.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="sync.json" LogicalName="sync.json" />
    <Content Remove="sync.json" />
  </ItemGroup>
</Project>
