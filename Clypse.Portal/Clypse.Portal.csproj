<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Formatting data (dates, numbers) for every culture, so the app can switch language at runtime. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <!-- Release builds are stamped with when they were built (UTC), shown in Settings > About, so a deployed build can be
       told apart from the last one. Debug builds are not, so they still build incrementally. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>
  <!--
    Release builds are compiled ahead of time to WebAssembly when published (needs the wasm-tools workload:
    dotnet workload install wasm-tools), as the original clypse was. Argon2id, AES-GCM and loading a large vault run
    many times faster than in the interpreted builds of dotnet run and the UI tests. The SDK only AOT compiles on
    publish; a Release build relinks the native runtime instead, so after changing these, build clean, or the old
    output fails at runtime ("function signature mismatch"). AOT makes publishing considerably slower.
    InvariantGlobalization (which the original also set) is not: the app's languages and plural forms need ICU.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blazing.Mvvm" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- The AWS base stack and deploy scripts at the framework's version, run by cloudformation/deploy.ps1. -->
    <PackageReference Include="Devoctomy.Blazwiz.Aws" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Clypse.Portal.Application\Clypse.Portal.Application.csproj" />
    <ProjectReference Include="..\Clypse.Portal.Models\Clypse.Portal.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <!--
    Per-environment look: when ClypseEnvironment is set (cloudformation/deploy.ps1 sets it to the environment being
    deployed) and Resources/environments/<environment>/wwwroot exists, each file in it replaces the portal's wwwroot
    file at the same path (icons, logo, css/theme.css), or is added. Done at build time, so the service worker's asset
    hashes match what is served. Without the folder, the portal's own files are used.
  -->
  <PropertyGroup>
    <ClypseEnvironmentWwwRoot>$(MSBuildThisFileDirectory)..\Resources\environments\$(ClypseEnvironment)\wwwroot\</ClypseEnvironmentWwwRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(ClypseEnvironment)' != '' And Exists('$(ClypseEnvironmentWwwRoot)')">
    <ClypseEnvironmentFile Include="$(ClypseEnvironmentWwwRoot)**\*" />
    <Content Remove="@(ClypseEnvironmentFile->'wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Content Include="@(ClypseEnvironmentFile)" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Static web assets give every discovered file the project's wwwroot as its content root. Publishing copies each
       file from its own path, but the dev server (dotnet run) serves content root + path, so point the environment's
       files at their own folder, or it would serve the portal's files instead. -->
  <Target Name="ClypseUseEnvironmentContentRoot" AfterTargets="ResolveProjectStaticWebAssets" Condition="'$(ClypseEnvironment)' != '' And Exists('$(ClypseEnvironmentWwwRoot)')">
    <PropertyGroup>
      <_ClypseEnvironmentWwwRootFull>$([System.IO.Path]::GetFullPath('$(ClypseEnvironmentWwwRoot)'))</_ClypseEnvironmentWwwRootFull>
    </PropertyGroup>
    <ItemGroup>
      <_ClypseEnvironmentAsset Include="@(StaticWebAsset)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('$(_ClypseEnvironmentWwwRootFull)', System.StringComparison.OrdinalIgnoreCase))" />
      <StaticWebAsset Remove="@(_ClypseEnvironmentAsset)" />
      <StaticWebAsset Include="@(_ClypseEnvironmentAsset)" ContentRoot="$(_ClypseEnvironmentWwwRootFull)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="sync.json" LogicalName="sync.json" />
    <Content Remove="sync.json" />
  </ItemGroup>
</Project>
