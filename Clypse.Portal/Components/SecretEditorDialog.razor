@inherits MvvmComponentBase<SecretEditorViewModel>

<ModalDialog Id="secret-dialog" Title="@(ViewModel.IsNew ? T["Secret.New"] : T["Secret.Edit"])" Icon="@VaultViewModel.GetIcon(ViewModel.SecretType)"
             SizeClass="modal-lg" OnClose="CloseAsync">
    <ChildContent>
        @if (ViewModel.IsNew)
        {
            <fieldset class="mb-3" id="secret-type">
                <legend class="form-label">@T["Secret.Type"]</legend>
                <div class="secret-type-options">
                    @foreach (var type in SecretEditorViewModel.SecretTypes)
                    {
                        <button type="button" class="secret-type-option @(type == ViewModel.SecretType ? "active" : null)"
                                data-type="@type" aria-pressed="@((type == ViewModel.SecretType).ToString().ToLowerInvariant())"
                                @onclick="() => ViewModel.SelectType(type)">
                            <i class="bi @VaultViewModel.GetIcon(type)"></i>
                            <span class="secret-type-name">@T["SecretType." + type]</span>
                            <span class="secret-type-description">@T["SecretType." + type + ".Description"]</span>
                        </button>
                    }
                </div>
            </fieldset>
        }

        <form id="secret-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            @foreach (var field in ViewModel.Fields)
            {
                var id = "secret-field-" + field.Name;
                <div class="mb-3">
                    <label class="form-label" for="@id">
                        @T["Secret.Field." + field.Name]@if (field.IsRequired)
                        {
                            <span class="text-danger ms-1" aria-hidden="true">*</span>
                        }
                    </label>
                    @switch (field.FieldType)
                    {
                        case SecretFieldType.MultiLineText:
                            <textarea class="form-control" id="@id" rows="4" disabled="@ViewModel.IsWorking"
                                      value="@ViewModel.GetValue(field.Name)"
                                      @oninput="e => ViewModel.SetValueAsync(field.Name, e.Value?.ToString())"></textarea>
                            break;
                        case SecretFieldType.Password:
                            var revealed = ViewModel.IsRevealed(field.Name);
                            var strength = ViewModel.GetStrength(field.Name);
                            <div class="input-group">
                                <input type="@(revealed ? "text" : "password")" class="form-control font-monospace" id="@id"
                                       autocomplete="new-password" spellcheck="false" disabled="@ViewModel.IsWorking"
                                       value="@ViewModel.GetValue(field.Name)"
                                       @oninput="e => ViewModel.SetValueAsync(field.Name, e.Value?.ToString())" />
                                <button type="button" class="btn btn-outline-secondary secret-reveal" title="@(revealed ? T["Secret.Password.Hide"] : T["Secret.Password.Show"])"
                                        @onclick="() => ViewModel.ToggleReveal(field.Name)">
                                    <i class="bi @(revealed ? "bi-eye-slash" : "bi-eye")"></i>
                                    <span class="visually-hidden">@(revealed ? T["Secret.Password.Hide"] : T["Secret.Password.Show"])</span>
                                </button>
                                <button type="button" class="btn btn-outline-primary secret-generate" title="@T["Secret.Password.Generate"]"
                                        disabled="@ViewModel.IsWorking" @onclick="() => ViewModel.OpenGenerator(field.Name)">
                                    <i class="bi bi-magic"></i>
                                    <span class="visually-hidden">@T["Secret.Password.Generate"]</span>
                                </button>
                            </div>
                            @if (strength.Percent > 0 || strength.Estimation == PasswordComplexityEstimation.Unknown)
                            {
                                <div class="strength-meter mt-2" data-strength="@strength.Estimation">
                                    <div class="progress" role="progressbar" aria-valuenow="@strength.Percent" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar bg-@strength.Tone" style="width: @(strength.Percent)%"></div>
                                    </div>
                                    <div class="strength-text small text-body-secondary mt-1">@ViewModel.GetStrengthText(field.Name)</div>
                                </div>
                            }
                            break;
                        case SecretFieldType.TagList:
                            <input type="text" class="form-control" id="@id" autocomplete="off" disabled="@ViewModel.IsWorking"
                                   value="@ViewModel.GetValue(field.Name)"
                                   @oninput="e => ViewModel.SetValueAsync(field.Name, e.Value?.ToString())" />
                            <div class="form-text">@T["Secret.Field.Tags.Hint"]</div>
                            break;
                        default:
                            <input type="text" class="form-control" id="@id" autocomplete="off" disabled="@ViewModel.IsWorking"
                                   value="@ViewModel.GetValue(field.Name)"
                                   @oninput="e => ViewModel.SetValueAsync(field.Name, e.Value?.ToString())" />
                            break;
                    }
                </div>
            }
        </form>

        @if (ViewModel.LastUpdatedAt is { } lastUpdated)
        {
            <p class="small text-body-secondary mb-0" id="secret-last-updated">@T["Secret.LastUpdated", lastUpdated.ToLocalTime().ToString("g")]</p>
        }

        @if (ViewModel.IsConfirmingDelete)
        {
            <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2 mt-3 mb-0" role="alert" id="secret-delete-confirm">
                <span class="flex-grow-1"><i class="bi bi-exclamation-triangle me-1"></i>@T["Secret.Delete.Confirm"]</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="secret-delete-no" disabled="@ViewModel.IsWorking"
                        @onclick="() => ViewModel.ConfirmDelete(false)">@T["Secret.Delete.No"]</button>
                <button type="button" class="btn btn-sm btn-danger" id="secret-delete-yes" disabled="@ViewModel.IsWorking"
                        @onclick="DeleteAsync">@T["Secret.Delete.Yes"]</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewModel.Error))
        {
            <div class="text-danger mt-3" id="secret-error">@ViewModel.Error</div>
        }
    </ChildContent>
    <Footer>
        @if (!ViewModel.IsNew)
        {
            <button type="button" class="btn btn-outline-danger me-auto" id="secret-delete" disabled="@(ViewModel.IsWorking || ViewModel.IsConfirmingDelete)"
                    @onclick="() => ViewModel.ConfirmDelete(true)">
                <i class="bi bi-trash me-1"></i>@T["Secret.Delete"]
            </button>
        }
        <button type="button" class="btn btn-secondary" disabled="@ViewModel.IsWorking" @onclick="CloseAsync">@T["Common.Cancel"]</button>
        <button type="submit" form="secret-form" class="btn btn-primary" id="secret-save" disabled="@ViewModel.IsWorking">
            @if (ViewModel.IsWorking)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            }
            @T["Secret.Save"]
        </button>
    </Footer>
</ModalDialog>

@if (ViewModel.GeneratingFor != null)
{
    <PasswordGeneratorDialog OnUse="password => ViewModel.CloseGeneratorAsync(password)" OnClose="() => ViewModel.CloseGeneratorAsync(null)" />
}
