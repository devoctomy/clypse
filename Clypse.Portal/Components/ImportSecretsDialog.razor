@inherits MvvmComponentBase<ImportSecretsViewModel>

<ModalDialog Id="import-dialog" Title="@T["Import.Title"]" Icon="bi-box-arrow-in-down" OnClose="CloseAsync">
    <ChildContent>
        <p>@T["Import.Intro"]</p>
        <div class="mb-3">
            <label class="form-label" for="import-format">@T["Import.Format"]</label>
            <select class="form-select" id="import-format" disabled="@ViewModel.IsWorking" value="@ViewModel.Format"
                    @onchange="e => ViewModel.SetFormat(Enum.Parse<CsvImportDataFormat>(e.Value?.ToString() ?? string.Empty))">
                @foreach (var format in ImportSecretsViewModel.Formats)
                {
                    <option value="@format">@ViewModel.GetFormatName(format)</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="import-file">@T["Import.File"]</label>
            <InputFile id="import-file" class="form-control" accept=".csv,text/csv" disabled="@ViewModel.IsWorking" OnChange="LoadFileAsync" />
        </div>
        <div class="alert alert-warning small mb-0" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@T["Import.Warning"]
        </div>

        @if (ViewModel.FoundText != null && ViewModel.DoneText == null)
        {
            <div class="text-body-secondary mt-3" id="import-found">@ViewModel.FoundText</div>
        }
        @if (ViewModel.DoneText != null)
        {
            <div class="text-success mt-3" id="import-done"><i class="bi bi-check-circle me-1"></i>@ViewModel.DoneText</div>
        }
        @if (!string.IsNullOrEmpty(ViewModel.Error))
        {
            <div class="text-danger mt-3" id="import-error">@ViewModel.Error</div>
        }
    </ChildContent>
    <Footer>
        @if (ViewModel.DoneText != null)
        {
            <button type="button" class="btn btn-primary" id="import-close" @onclick="CloseAsync">@T["Common.Close"]</button>
        }
        else
        {
            <button type="button" class="btn btn-secondary" disabled="@ViewModel.IsWorking" @onclick="CloseAsync">@T["Common.Cancel"]</button>
            <button type="button" class="btn btn-primary" id="import-confirm" disabled="@(!ViewModel.CanImport)" @onclick="() => ViewModel.ImportAsync()">
                @if (ViewModel.IsWorking)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                }
                @T["Import.Import"]
            </button>
        }
    </Footer>
</ModalDialog>
