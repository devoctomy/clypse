@inherits MvvmComponentBase<PasswordGeneratorSettingsViewModel>

<div class="panel mb-4" id="generator-settings">
    <h2 class="panel-title">@T["GeneratorSettings.Title"]</h2>
    <p class="panel-text">@T["GeneratorSettings.Text"]</p>

    @if (ViewModel.IsLoaded)
    {
        <div class="mb-3">
            <span class="form-label d-block">@T["GeneratorSettings.StartWith"]</span>
            <div class="btn-group" role="group" id="generator-settings-mode">
                <button type="button" class="btn btn-sm @(ViewModel.IsMemorable ? "btn-outline-primary" : "btn-primary")" id="generator-settings-random"
                        @onclick="() => ViewModel.IsMemorable = false">@T["Generator.Mode.Random"]</button>
                <button type="button" class="btn btn-sm @(ViewModel.IsMemorable ? "btn-primary" : "btn-outline-primary")" id="generator-settings-memorable"
                        @onclick="() => ViewModel.IsMemorable = true">@T["Generator.Mode.Memorable"]</button>
            </div>
        </div>

        @* Only the settings of the kind of password chosen. *@
        @if (!ViewModel.IsMemorable)
        {
            <div class="mb-3">
                <label class="form-label" for="generator-settings-length">@ViewModel.LengthText</label>
                <input type="range" class="form-range" id="generator-settings-length"
                       min="@PasswordGeneratorViewModel.MinimumLength" max="@PasswordGeneratorViewModel.MaximumLength" value="@ViewModel.Length"
                       @oninput="e => ViewModel.Length = int.Parse(e.Value?.ToString() ?? string.Empty, System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            <div class="generator-groups mb-2">
                @foreach (var group in PasswordGeneratorViewModel.Groups)
                {
                    var id = "generator-settings-group-" + group.ToString().ToLowerInvariant();
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@id" checked="@ViewModel.Uses(group)"
                               @onchange="e => ViewModel.SetGroup(group, e.Value is true)" />
                        <label class="form-check-label" for="@id">@T["Generator.Group." + group]</label>
                    </div>
                }
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="generator-settings-at-least-one" checked="@ViewModel.AtLeastOneOfEach"
                       @onchange="e => ViewModel.AtLeastOneOfEach = e.Value is true" />
                <label class="form-check-label" for="generator-settings-at-least-one">@T["Generator.AtLeastOne"]</label>
            </div>
        }
        else
        {
            <h3 class="h6 mt-4">@T["GeneratorSettings.Templates"]</h3>
            <p class="small text-body-secondary">@T["GeneratorSettings.Templates.Help"]</p>
            <ul class="list-unstyled mb-3" id="generator-templates">
                @foreach (var template in ViewModel.BuiltInTemplates)
                {
                    <li class="generator-template">
                        <span class="generator-template-name" data-user-content>@template.Name</span>
                        <code class="generator-template-pattern" data-user-content>@template.Template</code>
                        <span class="badge text-bg-secondary">@T["GeneratorSettings.Templates.BuiltIn"]</span>
                    </li>
                }
                @foreach (var template in ViewModel.UserTemplates)
                {
                    <li class="generator-template" data-template="@template.Name">
                        <span class="generator-template-name" data-user-content>@template.Name</span>
                        <code class="generator-template-pattern" data-user-content>@template.Template</code>
                        <button type="button" class="btn btn-sm btn-outline-danger generator-template-remove"
                                @onclick="() => ViewModel.RemoveTemplateCommand.Execute(template.Name)">@T["GeneratorSettings.Template.Remove"]</button>
                    </li>
                }
            </ul>

            <div class="row g-2 align-items-end mb-2">
                <div class="col-sm-4">
                    <label class="form-label small" for="generator-template-name">@T["GeneratorSettings.Template.Name"]</label>
                    <input type="text" class="form-control form-control-sm" id="generator-template-name" autocomplete="off"
                           @bind="ViewModel.NewTemplateName" @bind:event="oninput" />
                </div>
                <div class="col-sm-8">
                    <label class="form-label small" for="generator-template-pattern">@T["GeneratorSettings.Template.Pattern"]</label>
                    <input type="text" class="form-control form-control-sm font-monospace" id="generator-template-pattern" autocomplete="off" spellcheck="false"
                           @bind="ViewModel.NewTemplate" @bind:event="oninput" />
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="generator-template-try" @onclick="() => ViewModel.TryTemplateCommand.ExecuteAsync(null)">
                    <i class="bi bi-magic me-1"></i>@T["Generator.Regenerate"]
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="generator-template-add" @onclick="() => ViewModel.AddTemplateCommand.ExecuteAsync(null)">
                    <i class="bi bi-plus-lg me-1"></i>@T["GeneratorSettings.Template.Add"]
                </button>
                @if (ViewModel.Example != null)
                {
                    <span class="small" id="generator-template-example">@T["GeneratorSettings.Template.Example", ViewModel.Example]</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(ViewModel.Error))
            {
                <div class="text-danger small mb-3" id="generator-settings-error">@ViewModel.Error</div>
            }

            @if (ViewModel.Templates.Count > 0)
            {
                <div class="mb-3">
                    <label class="form-label" for="generator-settings-template">@T["Generator.Template"]</label>
                    <select class="form-select" id="generator-settings-template" value="@ViewModel.Template"
                            @onchange="e => ViewModel.Template = e.Value?.ToString()">
                        @foreach (var template in ViewModel.Templates)
                        {
                            <option value="@template.Name" data-user-content>@template.Name</option>
                        }
                    </select>
                </div>
            }
        }

        <button type="button" class="btn btn-primary" id="generator-settings-save" @onclick="() => ViewModel.SaveCommand.ExecuteAsync(null)">
            @T["GeneratorSettings.Save"]
        </button>
    }
</div>
