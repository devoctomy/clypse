@inherits MvvmComponentBase<ClipboardSettingsViewModel>

<div class="panel mb-4" id="clipboard-settings">
    <h2 class="panel-title">@T["ClipboardSettings.Title"]</h2>
    <p class="panel-text">@T["ClipboardSettings.Text"]</p>

    @if (ViewModel.IsLoaded)
    {
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="clipboard-settings-clear" checked="@ViewModel.ClearSecrets"
                   @onchange="e => ViewModel.ClearSecrets = e.Value is true" />
            <label class="form-check-label" for="clipboard-settings-clear">@T["ClipboardSettings.Clear"]</label>
        </div>

        @if (ViewModel.ClearSecrets)
        {
            <div class="mb-3">
                <label class="form-label" for="clipboard-settings-after">@T["ClipboardSettings.ClearAfter"]</label>
                <select class="form-select" id="clipboard-settings-after"
                        value="@ViewModel.ClearAfterSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                        @onchange="e => ViewModel.ClearAfterSeconds = int.Parse(e.Value?.ToString() ?? string.Empty, System.Globalization.CultureInfo.InvariantCulture)">
                    @foreach (var seconds in ViewModel.Options)
                    {
                        <option value="@seconds.ToString(System.Globalization.CultureInfo.InvariantCulture)">@ViewModel.GetSecondsText(seconds)</option>
                    }
                </select>
            </div>
        }

        <button type="button" class="btn btn-primary" id="clipboard-settings-save" @onclick="() => ViewModel.SaveCommand.ExecuteAsync(null)">
            @T["ClipboardSettings.Save"]
        </button>
    }
</div>
