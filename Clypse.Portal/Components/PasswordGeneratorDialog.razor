@inherits MvvmComponentBase<PasswordGeneratorViewModel>

<ModalDialog Id="generator-dialog" Title="@T["Generator.Title"]" Icon="bi-magic" OnClose="() => OnClose.InvokeAsync()">
    <ChildContent>
        @if (ViewModel.CanMakeMemorable)
        {
            <div class="btn-group w-100 mb-3" role="group" id="generator-mode">
                <button type="button" class="btn @(ViewModel.IsMemorable ? "btn-outline-primary" : "btn-primary")" id="generator-mode-random"
                        aria-pressed="@((!ViewModel.IsMemorable).ToString().ToLowerInvariant())"
                        @onclick="() => ViewModel.SetMemorableAsync(false)">@T["Generator.Mode.Random"]</button>
                <button type="button" class="btn @(ViewModel.IsMemorable ? "btn-primary" : "btn-outline-primary")" id="generator-mode-memorable"
                        aria-pressed="@ViewModel.IsMemorable.ToString().ToLowerInvariant()"
                        @onclick="() => ViewModel.SetMemorableAsync(true)">@T["Generator.Mode.Memorable"]</button>
            </div>
        }

        <div class="generated-password" id="generated-password">
            <span data-user-content class="generated-password-text font-monospace">@ViewModel.Password</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="generator-regenerate" title="@T["Generator.Regenerate"]"
                    @onclick="() => ViewModel.GenerateAsync()">
                <i class="bi bi-arrow-repeat"></i><span class="visually-hidden">@T["Generator.Regenerate"]</span>
            </button>
        </div>
        @if (ViewModel.Strength.Percent > 0)
        {
            <div class="strength-meter mb-3" data-strength="@ViewModel.Strength.Estimation">
                <div class="progress" role="progressbar" aria-valuenow="@ViewModel.Strength.Percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-@ViewModel.Strength.Tone" style="width: @(ViewModel.Strength.Percent)%"></div>
                </div>
                <div class="strength-text small text-body-secondary mt-1">@ViewModel.StrengthText</div>
            </div>
        }

        @if (ViewModel.IsMemorable)
        {
            <div class="mb-3">
                <label class="form-label" for="generator-template">@T["Generator.Template"]</label>
                <select class="form-select" id="generator-template" value="@ViewModel.Template"
                        @onchange="e => ViewModel.SetTemplateAsync(e.Value?.ToString())">
                    @foreach (var template in ViewModel.Templates)
                    {
                        <option value="@template.Name" data-user-content>@template.Name</option>
                    }
                </select>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="generator-shuffle" checked="@ViewModel.Shuffle"
                       @onchange="e => ViewModel.SetShuffleAsync(e.Value is true)" />
                <label class="form-check-label" for="generator-shuffle">@T["Generator.Shuffle"]</label>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label" for="generator-length">@ViewModel.LengthText</label>
                <input type="range" class="form-range" id="generator-length"
                       min="@PasswordGeneratorViewModel.MinimumLength" max="@PasswordGeneratorViewModel.MaximumLength" value="@ViewModel.Length"
                       @oninput="e => ViewModel.SetLengthAsync(int.Parse(e.Value?.ToString() ?? string.Empty, System.Globalization.CultureInfo.InvariantCulture))" />
            </div>
            <div class="generator-groups mb-2">
                @foreach (var group in PasswordGeneratorViewModel.Groups)
                {
                    var id = "generator-group-" + group.ToString().ToLowerInvariant();
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@id" checked="@ViewModel.Uses(group)"
                               @onchange="e => ViewModel.SetGroupAsync(group, e.Value is true)" />
                        <label class="form-check-label" for="@id">@T["Generator.Group." + group]</label>
                    </div>
                }
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="generator-at-least-one" checked="@ViewModel.AtLeastOneOfEach"
                       @onchange="e => ViewModel.SetAtLeastOneOfEachAsync(e.Value is true)" />
                <label class="form-check-label" for="generator-at-least-one">@T["Generator.AtLeastOne"]</label>
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewModel.Error))
        {
            <div class="text-danger mt-3" id="generator-error">@ViewModel.Error</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">@T["Common.Cancel"]</button>
        <button type="button" class="btn btn-primary" id="generator-use" disabled="@string.IsNullOrEmpty(ViewModel.Password)"
                @onclick="() => OnUse.InvokeAsync(ViewModel.Password)">@T["Generator.Use"]</button>
    </Footer>
</ModalDialog>
