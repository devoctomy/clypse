<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UI tests of a deployed environment, run by the Deploy tests workflow (.github/workflows/deploy-tests.yml) after a
    deploy. Written as Reqnroll features (Features/*.feature) with their steps in Steps/, run by MSTest. The
    .DeployTests suffix keeps them out of CI's UnitTests and UITests filters. Without the CLYPSE_DEPLOYTEST_*
    environment variables every scenario is skipped. See cloudformation/README.md.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Reqnroll.MSTest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Files the scenarios import (made-up logins), e.g. the first 200 rows of Resources/medium-import.zip's KeePass CSV. -->
    <None Update="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Playwright" />
    <Using Include="Reqnroll" />
  </ItemGroup>
</Project>
